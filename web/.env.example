# DogeOS Testnet (chain id 6281971). Optional — these are the defaults
# baked into the app; only set them to target another chain.
NEXT_PUBLIC_CHAIN_ID=6281971
NEXT_PUBLIC_CHAIN_NAME="DogeOS Testnet"
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.dogeos.com/
NEXT_PUBLIC_EXPLORER_URL=https://blockscout.testnet.dogeos.com
NEXT_PUBLIC_NATIVE_SYMBOL=DOGE

# Required: EventEmitter address produced by contracts/deploy.sh.
NEXT_PUBLIC_EVENT_EMITTER_ADDRESS=0x...

# DogeOS SDK client ID. Ask your DogeOS contact, or leave blank for
# external-wallets-only mode (MetaMask, WalletConnect — no embedded
# email/social login).
NEXT_PUBLIC_DOGEOS_CLIENT_ID=

# Optional: WalletConnect project ID (free at cloud.walletconnect.com).
# Enables WalletConnect QR-code connection on top of injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# === Partner-side mock for external_rule quests ===
# These power the "External Quest" card, which simulates a partner's
# backend marking the user eligible to complete an external_rule quest.
# They live in *server-side* env vars (no NEXT_PUBLIC_ prefix) so the
# partner API key never reaches the browser. The Next.js API route at
# /api/partner-complete-quest reads them and forwards a request to DogeOS.
DOGEOS_API_URL=https://quest-api-staging.dogeos.com
# Generate via DogeOS admin UI → API Keys → Generate new key.
DOGEOS_PARTNER_API_KEY=
# UUID of the external_rule quest the "External Quest" card targets. Copy
# from /quests in the admin UI.
DOGEOS_EXTERNAL_QUEST_ID=
