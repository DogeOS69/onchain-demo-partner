{
  "openapi": "3.1.0",
  "info": {
    "title": "DogeOS Partner Eligibility API",
    "version": "1.0.0",
    "description": "Partner-server endpoint for External Rule quests. Marks eligibility; the player still verifies in Questing. Smart Contract Event quests do not use this endpoint. See the repository README for the complete integration walkthrough and production setup."
  },
  "servers": [
    {
      "url": "https://quest-api-staging.dogeos.com",
      "description": "Staging; use staging keys and quest IDs"
    },
    {
      "url": "https://quest-api.dogeos.com",
      "description": "Production; confirm production setup with DogeOS before use"
    }
  ],
  "security": [
    {
      "PartnerApiKey": []
    }
  ],
  "tags": [
    {
      "name": "External Rule",
      "description": "Signal eligibility from the partner backend."
    }
  ],
  "paths": {
    "/v2/partner-api/quests/{questId}/mark-eligible": {
      "post": {
        "operationId": "markExternalQuestEligible",
        "tags": [
          "External Rule"
        ],
        "summary": "Mark a wallet eligible to verify an External Rule quest",
        "description": "The key and quest must belong to the same partner in the same environment. Repeated signals upsert the same quest-wallet record, refresh its timestamp, and replace metadata. The general eligibility record has no expiry check and is not consumed by verification; coordinate recurring-action requirements with DogeOS. Keep API keys server-side.",
        "parameters": [
          {
            "name": "questId",
            "in": "path",
            "required": true,
            "description": "UUID of an existing, non-deleted external_rule quest owned by your partner.",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "example": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkEligibleRequest"
              },
              "example": {
                "walletAddress": "0x1111111111111111111111111111111111111111",
                "metadata": {
                  "score": 100,
                  "actionId": "example-action-123"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Eligibility recorded. This does not confirm quest completion or reward delivery.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkEligibleResponse"
                },
                "example": {
                  "data": {
                    "marked": true,
                    "questId": "11111111-1111-4111-8111-111111111111",
                    "walletAddress": "0x1111111111111111111111111111111111111111"
                  },
                  "status": 200
                }
              }
            }
          },
          "400": {
            "description": "Request parsing failed, for example an invalid quest UUID or malformed JSON. May be plain text.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported or missing application/json content type. May be plain text.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "API validation failure, including missing/revoked API key, invalid wallet, missing quest, partner mismatch, or unsupported quest type. A request-body type error may instead return plain text.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                },
                "example": {
                  "message": "Validation error: Missing X-Partner-API-Key header",
                  "status": 422,
                  "code": null,
                  "retryable": null,
                  "recommendedAction": null,
                  "source": null
                }
              },
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Other infrastructure or server failure. Check status and content type; do not assume a JSON error envelope."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PartnerApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Partner-API-Key",
        "description": "Raw partner key generated in the matching environment. Never expose it to the browser."
      }
    },
    "schemas": {
      "MarkEligibleRequest": {
        "type": "object",
        "required": [
          "walletAddress"
        ],
        "properties": {
          "walletAddress": {
            "type": "string",
            "description": "EVM address with lowercase 0x prefix and 40 hex characters. Surrounding whitespace is accepted and trimmed; the address is stored lowercase.",
            "pattern": "^\\s*0x[0-9a-fA-F]{40}\\s*$",
            "examples": [
              "0x1111111111111111111111111111111111111111"
            ]
          },
          "metadata": {
            "description": "Optional audit context; use a JSON object with your own action ID or score. Omitted or null becomes an empty object. Repeated signals replace existing metadata. Do not include secrets.",
            "examples": [
              {
                "score": 100,
                "actionId": "example-action-123"
              }
            ]
          }
        }
      },
      "MarkEligibleResponse": {
        "type": "object",
        "required": [
          "data",
          "status"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "marked",
              "questId",
              "walletAddress"
            ],
            "properties": {
              "marked": {
                "type": "boolean",
                "const": true
              },
              "questId": {
                "type": "string",
                "format": "uuid"
              },
              "walletAddress": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{40}$",
                "description": "Normalized lowercase EVM address."
              }
            }
          },
          "status": {
            "type": "integer",
            "const": 200
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "required": [
          "message",
          "status",
          "code",
          "retryable",
          "recommendedAction",
          "source"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "API validation message prefixed with Validation error: . See the README API reference for messages."
          },
          "status": {
            "type": "integer",
            "const": 422
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "retryable": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "recommendedAction": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
